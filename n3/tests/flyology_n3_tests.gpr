with "flyology_n3.gpr";

project Flyology_N3_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("n3_tests.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;
end Flyology_N3_Tests;
