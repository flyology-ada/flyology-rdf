with "flyology_rdf.gpr";

project Flyology_N3 is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "flyology_n3";
   for Library_Dir use "lib";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwJ", "-fstack-check",
         "-fno-strict-aliasing", "-O1", "-gnata");
   end Compiler;
end Flyology_N3;
