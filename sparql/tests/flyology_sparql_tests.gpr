with "flyology_sparql.gpr";

project Flyology_SPARQL_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("sparql_tests.adb", "sparql_conformance.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;
end Flyology_SPARQL_Tests;
