with "flyology_rdf.gpr";
with "flyology_iri.gpr";

project Flyology_RDF_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("iri_strictness_gate.adb", "terms_tests.adb", "statement_tests.adb",
      "cursor_tests.adb", "lexer_tests.adb", "parser_tests.adb",
      "serialization_tests.adb", "roundtrip_tests.adb",
      "canonicalization_tests.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;
end Flyology_RDF_Tests;
