with "flyology_rdf.gpr";
with "flyology_n3.gpr";
with "flyology_sparql.gpr";

project Flyology_RDF_Examples is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("examples.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;
end Flyology_RDF_Examples;
